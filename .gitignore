# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.venv/
venv/
.env
.venv.*

# Distribution / packaging
/dist/
/build/
/*.egg-info/
**/*.egg-info/
/*.egg/
/release/
/MaintiQ-Portable/
/MaintiQ-Setup.exe

# PyInstaller
*.spec
# The release PyInstaller spec is a required source asset and must stay tracked.
!packaging/maintiq.spec
*.manifest

# Installer (do not ignore the .iss template; ignore build output only)
/output/
/*.iss
/MaintiQ-Setup.exe

# Local unit test / coverage reports
/.coverage
/htmlcov/
/.coverage.*
/.pytest_cache/
/.req/

# Translations
*.mo
*.pot

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS
desktop.ini

# Logs (runtime user data)
/logs/
*.log

# Secrets / local user data (never commit)
*.env
*.key
*.pem

# Temporary files
*.tmp
*.temp
/tmp/
/temp/

# Python
*.pyc
